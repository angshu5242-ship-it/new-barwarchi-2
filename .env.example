# Neon Postgres (copy the pooled connection string from the Neon dashboard)
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Restaurant WhatsApp number that receives new-order alerts.
# Use country code and digits only. Multiple numbers can be comma-separated.
WHATSAPP_ORDER_TO=919366986853,919612281939

# WhatsApp Cloud API (Meta developer app)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=v21.0

# Optional utility template. Create a template named new_order_alert with 7 body params:
# {{1}} order id, {{2}} name, {{3}} phone, {{4}} delivery/pickup,
# {{5}} items, {{6}} total, {{7}} notes.
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=en

# OTP login (WhatsApp Cloud API + approved template). The template needs one
# body parameter: the 6-digit code. See SETUP-NEON-WHATSAPP.md section 5.
WHATSAPP_OTP_TEMPLATE_NAME=
WHATSAPP_OTP_TEMPLATE_LANG=en
# Set to true only if the approved OTP template has a URL button containing the code.
WHATSAPP_OTP_TEMPLATE_URL_BUTTON=false

# Strong random secrets. Example: openssl rand -hex 32
OTP_SECRET=replace-with-a-long-random-string
AUTH_SECRET=replace-with-another-long-random-string

# Dev-only: shows the OTP on screen. Never enable this on Vercel/production.
# OTP_DEV_MODE=false

# Set to true once OTP delivery is working. This blocks online orders from
# numbers that did not complete the OTP step. WhatsApp fallback still works.
REQUIRE_PHONE_VERIFICATION=false

# Used by the admin Orders tab. Keep this the same as the admin login password.
ADMIN_PASSWORD=change-this-admin-password

# First staff account. It is created automatically the first time the staff
# screen or Staff tab is opened. Change the password in Admin → Staff after
# the first sign-in.
STAFF_SEED_USERNAME=staff
STAFF_SEED_PASSWORD=choose-a-strong-staff-password
STAFF_SEED_DISPLAY_NAME=Kitchen Staff
# Optional: add a WhatsApp number to the seeded account for order alerts.
STAFF_SEED_PHONE=

# Send the new-order WhatsApp alert to active staff numbers as well as the
# restaurant numbers. Set to false if only the owner should receive alerts.
WHATSAPP_NOTIFY_STAFF=true

# Menu style studio (optional). The key is used only by the server to ask Gemini
# for a colour theme. Get one from Google AI Studio and never expose it in the
# browser. The studio still works with the built-in presets if this is blank.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Used in the customer WhatsApp fallback link.
RESTAURANT_NAME=New Bawarchi 2
RESTAURANT_WHATSAPP=919366986853

# UPI payment (optional). Leave UPI_ID blank to keep online UPI disabled.
# The admin Ordering & payment tab can also publish these values to Neon.
UPI_ID=
UPI_NAME=New Bawarchi 2

# Exact Google review link supplied by the owner. Review requests stay paused
# until this is set; the app never invents a Google listing URL.
GOOGLE_REVIEW_URL=

# Optional WhatsApp utility template for review requests. Body params:
# {{1}} customer name, {{2}} Google review URL.
WHATSAPP_REVIEW_TEMPLATE_NAME=
WHATSAPP_REVIEW_TEMPLATE_LANG=en

# Hours after completion before the daily review cron asks for a review.
REVIEW_DELAY_HOURS=2

# Protects /api/review-cron. Vercel Cron sends this automatically when the
# variable is set. Use a long random value.
CRON_SECRET=
